#!/usr/bin/env bash
# review-pr: check out a GitHub PR in an isolated git worktree and review it
# with Claude Code. Fork-aware: PRs are looked up in `upstream` first, then `origin`.
set -euo pipefail

CLAUDE_BIN="${CLAUDE_BIN:-claude}"
OUT_DIR="${REVIEW_PR_OUT_DIR:-$HOME/pr-reviews}"

usage() {
  cat <<'USAGE'
Usage:
  review-pr <pr>              Review interactively in a worktree
  review-pr -p <pr> [-o FILE] Non-interactive; write review to a file
  review-pr --here <pr>       Review from the current checkout (no worktree)
  review-pr --clean <pr>      Remove the worktree and refs for <pr>
  review-pr --list            List open PRs in the resolved repo
  review-pr --accounts        List Claude accounts and which one would be used here
  review-pr push-comment <pr> Post your finished review to the PR (asks to confirm)

<pr> is a number, owner/repo#number, or a GitHub PR URL.

Options:
  -a, --account NAME|DIR  Claude account (config dir) to use. NAME → ~/.claude-NAME,
                          "default" → ~/.claude. Precedence: --account >
                          $CLAUDE_CONFIG_DIR > git config review-pr.account > ~/.claude
  -R, --repo OWNER/REPO   Repo that owns the PR (default: upstream remote, else origin)
  -p, --print             Non-interactive (claude -p); output goes to a file
  -o, --out FILE          Output file for -p (default: ~/pr-reviews/<owner>-<repo>-pr-<n>.md)
      --here              Don't create a worktree; review using gh pr diff
      --setup CMD         Run CMD in the worktree before reviewing (e.g. "npm ci")
  -h, --help              Show this help

push-comment options:
      --comment           Post as a comment review (default)
      --approve           Post as an approval
      --request-changes   Post as "request changes"
  -f, --file FILE         Review file to post (default: the -p output file; if missing,
                          the final review is exported from your last Claude session
                          in the PR worktree)
      --regenerate        Re-export from the Claude session even if the file exists
  -e, --edit              Open the review in $EDITOR before posting
  -y, --yes               Don't ask for confirmation

Env: CLAUDE_BIN (default: claude), CLAUDE_CONFIG_DIR, REVIEW_PR_OUT_DIR (default: ~/pr-reviews)

Default account per repo / globally:
  git config review-pr.account vo            # this repo
  git config --global review-pr.account personal
USAGE
}

die() { echo "review-pr: $*" >&2; exit 1; }

slug_of_remote() {
  git remote get-url "$1" 2>/dev/null \
    | sed -E 's#^(git@[^:]+:|ssh://[^/]+/|https?://[^/]+/)##; s#\.git$##; s#/$##'
}

remote_for_slug() {
  local r
  for r in $(git remote); do
    if [ "$(slug_of_remote "$r" | tr 'A-Z' 'a-z')" = "$(echo "$1" | tr 'A-Z' 'a-z')" ]; then
      echo "$r"; return 0
    fi
  done
  return 1
}

# --- Claude account helpers (kept in sync with install.sh) ---
resolve_account() { # NAME|PATH -> config dir
  case "$1" in
    default)   echo "$HOME/.claude" ;;
    */*|"~"*)  echo "${1/#\~/$HOME}" ;;
    *)         echo "$HOME/.claude-$1" ;;
  esac
}
account_name() { # config dir -> short name
  case "$1" in
    "$HOME/.claude")   echo "default" ;;
    "$HOME"/.claude-*) echo "${1#"$HOME"/.claude-}" ;;
    *)                 echo "$1" ;;
  esac
}
detect_accounts() {
  local d
  for d in "$HOME/.claude" "$HOME"/.claude-*; do
    [ -d "$d" ] || continue
    if [ -e "$d/settings.json" ] || [ -e "$d/history.jsonl" ] || [ -e "$d/.claude.json" ] || [ -d "$d/projects" ]; then
      echo "$d"
    fi
  done
}
# Sets claude_dir and claude_src. Precedence: --account > env > git config > default.
pick_account() {
  local a
  if [ -n "$account" ]; then
    claude_dir="$(resolve_account "$account")"; claude_src="--account"
  elif [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
    claude_dir="${CLAUDE_CONFIG_DIR/#\~/$HOME}"; claude_src="CLAUDE_CONFIG_DIR"
  elif a="$(git config --get review-pr.account 2>/dev/null)" && [ -n "$a" ]; then
    claude_dir="$(resolve_account "$a")"; claude_src="git config review-pr.account"
  else
    claude_dir="$HOME/.claude"; claude_src="default"
  fi
  claude_dir="${claude_dir%/}"
}

repo=""; pr=""; mode="interactive"; out=""; here=0; clean=0; list=0; setup=""
account=""; list_accounts=0
cmd="review"; event="comment"; regen=0; edit=0; yes=0
if [ "${1:-}" = "push-comment" ]; then cmd="push"; shift; fi
while [ $# -gt 0 ]; do
  case "$1" in
    --comment)         event="comment"; shift ;;
    --approve)         event="approve"; shift ;;
    --request-changes) event="request-changes"; shift ;;
    -f|--file)         out="${2:?missing value for $1}"; shift 2 ;;
    --regenerate)      regen=1; shift ;;
    -e|--edit)         edit=1; shift ;;
    -y|--yes)          yes=1; shift ;;
    -a|--account) account="${2:?missing value for $1}"; shift 2 ;;
    --accounts) list_accounts=1; shift ;;
    -R|--repo)  repo="${2:?missing value for $1}"; shift 2 ;;
    -p|--print) mode="print"; shift ;;
    -o|--out)   out="${2:?missing value for $1}"; shift 2 ;;
    --here)     here=1; shift ;;
    --clean)    clean=1; shift ;;
    --list)     list=1; shift ;;
    --setup)    setup="${2:?missing value for $1}"; shift 2 ;;
    -h|--help)  usage; exit 0 ;;
    -*)         die "unknown option: $1 (see --help)" ;;
    *)          [ -z "$pr" ] || die "only one PR at a time"; pr="$1"; shift ;;
  esac
done

if [ $list_accounts -eq 1 ]; then
  pick_account
  echo "Claude accounts (* = used here, via $claude_src):"
  found=0
  while IFS= read -r d; do
    [ "$d" = "$claude_dir" ] && { mark="*"; found=1; } || mark=" "
    if [ -e "$d/skills/pr-review/SKILL.md" ] && [ -e "$d/commands/review-pr.md" ]; then s="pr-review installed"; else s="not installed"; fi
    printf " %s %-12s %-40s %s\n" "$mark" "$(account_name "$d")" "$d" "$s"
  done < <(detect_accounts)
  [ $found -eq 1 ] || echo " * $claude_dir (not detected as a Claude config dir)"
  exit 0
fi

if [ "$cmd" = "review" ] && [ $clean -eq 0 ] && [ $list -eq 0 ]; then
  pick_account
  [ -d "$claude_dir" ] || die "Claude config dir not found: $claude_dir (from $claude_src). Log in first: CLAUDE_CONFIG_DIR=$claude_dir claude"
fi

command -v git >/dev/null || die "git not found"
command -v gh  >/dev/null || die "gh (GitHub CLI) not found"
git rev-parse --git-dir >/dev/null 2>&1 || die "run this inside a git repository"

# Parse PR argument forms.
case "$pr" in
  http*://*/pull/*)
    repo="$(echo "$pr" | sed -E 's#^https?://[^/]+/([^/]+/[^/]+)/pull/.*#\1#')"
    pr="$(echo "$pr" | sed -E 's#.*/pull/([0-9]+).*#\1#')" ;;
  */*\#*)
    repo="${pr%%#*}"; pr="${pr##*#}" ;;
esac
if [ $list -eq 0 ]; then
  [ -n "$pr" ] || { usage; exit 1; }
  [[ "$pr" =~ ^[0-9]+$ ]] || die "invalid PR number: $pr"
fi

# Resolve repo: explicit > upstream > origin.
candidates=()
if [ -n "$repo" ]; then
  candidates=("$repo")
else
  for r in upstream origin; do
    s="$(slug_of_remote "$r" || true)"
    [ -n "$s" ] && candidates+=("$s")
  done
  [ ${#candidates[@]} -gt 0 ] || die "no upstream/origin remote; pass --repo OWNER/REPO"
fi

if [ $list -eq 1 ]; then
  echo "Open PRs in ${candidates[0]}:"
  exec gh pr list --repo "${candidates[0]}"
fi

root="$(git rev-parse --show-toplevel)"
wt="$(dirname "$root")/$(basename "$root")-review-pr-$pr"
ref_head="refs/review/pr-$pr/head"
ref_base="refs/review/pr-$pr/base"

if [ $clean -eq 1 ]; then
  if [ -d "$wt" ]; then git worktree remove --force "$wt" && echo "Removed $wt"; fi
  git update-ref -d "$ref_head" 2>/dev/null || true
  git update-ref -d "$ref_base" 2>/dev/null || true
  git worktree prune
  exit 0
fi

base=""; title=""; state=""
for c in "${candidates[@]}"; do
  if info="$(gh pr view "$pr" --repo "$c" --json baseRefName,state,title -q '.baseRefName + "\t" + .state + "\t" + .title' 2>/dev/null)"; then
    repo="$c"; base="${info%%$'\t'*}"; rest="${info#*$'\t'}"
    state="${rest%%$'\t'*}"; title="${rest#*$'\t'}"; break
  fi
done
[ -n "$base" ] || die "PR #$pr not found in: ${candidates[*]} (use --repo OWNER/REPO)"
echo "→ $repo#$pr: $title (base: $base)"

target="$repo#$pr"
out="${out:-$OUT_DIR/$(echo "$repo" | tr '/' '-')-pr-$pr.md}"

claude_env() { # select the Claude account and export it for child processes
  command -v "$CLAUDE_BIN" >/dev/null || die "$CLAUDE_BIN not found"
  pick_account
  [ -d "$claude_dir" ] || die "Claude config dir not found: $claude_dir (from $claude_src). Log in first: CLAUDE_CONFIG_DIR=$claude_dir claude"
  if [ "$claude_dir" = "$HOME/.claude" ]; then
    # Default account: leave CLAUDE_CONFIG_DIR unset; Claude then uses ~/.claude.json
    # (setting it would move that file into the config dir and lose the login).
    unset CLAUDE_CONFIG_DIR
  else
    export CLAUDE_CONFIG_DIR="$claude_dir"
  fi
  echo "→ Claude account: $(account_name "$claude_dir") ($claude_dir, via $claude_src)"
}

run_claude() {
  claude_env
  if [ ! -e "$claude_dir/skills/pr-review/SKILL.md" ] && [ ! -e ".claude/skills/pr-review/SKILL.md" ]; then
    echo "  ! pr-review is not installed for this account. Run: install.sh --account $(account_name "$claude_dir")" >&2
  fi
  if [ "$mode" = "print" ]; then
    mkdir -p "$(dirname "$out")"
    echo "→ Writing review to $out"
    "$CLAUDE_BIN" -p "/review-pr $target" > "$out"
    echo "Done: $out"
    echo "Edit it if needed, then post with: review-pr push-comment $pr"
  else
    "$CLAUDE_BIN" "/review-pr $target"
  fi
}

EXPORT_PROMPT='Output the final version of the pull request review from this conversation, including every change I asked for during the session, as GitHub-flavored markdown ready to post as a PR review. Output only the review itself: no preamble, no closing remarks, no code fence around the whole review. Do not run any tools.'

push_comment() {
  if [ "$state" != "OPEN" ]; then
    echo "! PR $target is $state."
  fi

  # 1. Get the review text.
  if [ ! -s "$out" ] || [ $regen -eq 1 ]; then
    [ -d "$wt" ] || die "No review file at $out and no review worktree at $wt.
Run 'review-pr $pr' or 'review-pr -p $pr' first, or pass -f FILE."
    claude_env
    echo "→ Exporting the final review from your last Claude session in $wt"
    mkdir -p "$(dirname "$out")"
    (cd "$wt" && "$CLAUDE_BIN" -c -p "$EXPORT_PROMPT") > "$out.tmp" \
      || { rm -f "$out.tmp"; die "export from Claude session failed"; }
    [ -s "$out.tmp" ] || { rm -f "$out.tmp"; die "Claude returned an empty review"; }
    mv "$out.tmp" "$out"
    echo "→ Saved to $out"
  fi

  # 2. Optional edit.
  if [ $edit -eq 1 ]; then
    "${VISUAL:-${EDITOR:-vi}}" "$out" </dev/tty >/dev/tty
  fi
  [ -s "$out" ] || die "review file is empty: $out"

  # 3. Show what will be posted.
  verdict="$(grep -m1 -oE 'Request changes|Approve with comments|Approve' "$out" || true)"
  echo
  echo "  PR:      $target — $title"
  echo "  Event:   $event"
  echo "  File:    $out ($(wc -l < "$out" | tr -d ' ') lines)"
  [ -n "$verdict" ] && echo "  Verdict: $verdict (from the review text)"
  echo "  ---------------------------------------------"
  head -n 15 "$out" | sed 's/^/  │ /'
  [ "$(wc -l < "$out")" -gt 15 ] && echo "  │ ..."
  echo "  ---------------------------------------------"
  case "$event:$verdict" in
    approve:"Request changes")      echo "! Posting an APPROVAL, but the review says 'Request changes'." ;;
    request-changes:Approve*)       echo "! Requesting changes, but the review says '$verdict'." ;;
    comment:"Request changes")      echo "  Tip: add --request-changes to block the merge." ;;
  esac
  if [ -e "$out.posted" ]; then
    echo "! Already posted from this file: $(tail -n 1 "$out.posted")"
  fi

  # 4. Confirm and post.
  if [ $yes -eq 0 ]; then
    printf "Post this review to %s? [y/N] " "$target"
    { read -r ans </dev/tty; } 2>/dev/null || { echo; die "no terminal to confirm; use --yes"; }
    case "$ans" in y|Y|yes|YES) ;; *) echo "Not posted."; exit 1 ;; esac
  fi
  gh pr review "$pr" --repo "$repo" "--$event" --body-file "$out"
  echo "$(date '+%Y-%m-%d %H:%M') --$event" >> "$out.posted"
  echo "Posted: $(gh pr view "$pr" --repo "$repo" --json url -q .url)"
}

if [ "$cmd" = "push" ]; then
  push_comment
  exit 0
fi

if [ $here -eq 1 ]; then
  run_claude
  exit 0
fi

# Fetch PR head and base into private refs (works for fork PRs, no gh checkout needed).
remote="$(remote_for_slug "$repo" || true)"
if [ -z "$remote" ]; then
  remote="$(gh repo view "$repo" --json url -q .url).git"
fi
echo "→ Fetching PR head and $base from $remote"
git fetch --no-tags --quiet "$remote" \
  "+refs/pull/$pr/head:$ref_head" \
  "+refs/heads/$base:$ref_base"

if [ -d "$wt" ]; then
  echo "→ Updating existing worktree $wt"
  git -C "$wt" checkout --quiet --detach "$ref_head"
else
  echo "→ Creating worktree $wt"
  git worktree add --quiet --detach "$wt" "$ref_head"
fi

cd "$wt"
if [ -n "$setup" ]; then
  echo "→ Running setup: $setup"
  bash -c "$setup"
fi
run_claude
echo
echo "Worktree kept at $wt."
echo "  Post the review:  review-pr push-comment $pr [--approve|--request-changes]"
echo "  Remove worktree:  review-pr --clean $pr"
